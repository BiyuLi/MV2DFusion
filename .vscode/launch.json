    "version": "0.2.0",
    "configurations": [
        {
            "name": "train-r50",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/tools/train.py",
            "console": "integratedTerminal",
            "args": ["${workspaceFolder}/projects/configs/nusc/mv2dfusion-fsd_freeze-r50_1600_gridmask-ep24_nusc_debug.py", "--work-dir", "${workspaceFolder}/work_dirs/mv2dfusion-fsd_freeze-r50_1600_gridmask-ep24_debug"],
            "python": "${command:python.interpreterPath}", // 自动使用当前选择的解释器
            "justMyCode": false
        },
        {
            "name": "test-r50",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/tools/test.py",
            "console": "integratedTerminal",
            "args": ["${workspaceFolder}/projects/configs/nusc/mv2dfusion-fsd_freeze-r50_1600_gridmask-ep24_nusc.py", "weights/r50_latest.pth", "--eval", "bbox"],
            "python": "${command:python.interpreterPath}", // 自动使用当前选择的解释器
            "justMyCode": false
        }
    ]
}